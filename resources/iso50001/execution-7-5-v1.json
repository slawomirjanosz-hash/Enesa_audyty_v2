    "LISTA_75": [
      {
        "tekst": "System zawiera udokumentowane informacje wymagane przez normę.",
        "podstawa": "N",
        "auto": "wymagane"
      },
      {
        "tekst": "System zawiera informacje uznane przez organizację za niezbędne dla jego skuteczności.",
        "podstawa": "N",
        "auto": "wlasne"
      },
      {
        "tekst": "Zapewniono identyfikację, opis, format i nośnik oraz przegląd i zatwierdzenie.",
        "podstawa": "N",
        "auto": "identyfikacja"
      },
      {
        "tekst": "Dokumenty są dostępne i przydatne tam, gdzie są potrzebne, oraz odpowiednio chronione.",
