  "definitions": {
    "LISTA_81": [
      {
        "tekst": "Określono procesy związane ze znaczącymi użyciami energii i działaniami z planów, które wymagają kryteriów.",
        "podstawa": "N",
        "auto": "procesy"
      },
      {
        "tekst": "Ustalono kryteria tam, gdzie ich brak może prowadzić do znaczącego odchylenia — w tym dla eksploatacji i utrzymania.",
        "podstawa": "N",
        "auto": "kryteria"
      },
      {
        "tekst": "Kryteria przekazano osobom, które ich używają, także wykonawcom.",
        "podstawa": "N",
        "auto": "przekazano"
      },
      {
        "tekst": "Procesy prowadzi się zgodnie z kryteriami — opisano tryby pracy i sposób sterowania.",
        "podstawa": "N",
        "auto": "zgodnie"
      },
      {
        "tekst": "Zachowano zapisy w zakresie potrzebnym do pewności, że procesy przebiegały zgodnie z planem.",
        "podstawa": "N",
        "auto": "zapisy"
      },
      {
        "tekst": "Nadzorowane są zmiany planowane; skutki zmian niezamierzonych są przeglądane i ograniczane.",
        "podstawa": "N",
        "auto": "zmiany"
      },
      {
        "tekst": "Nadzorowane są zlecone na zewnątrz znaczące użycia energii i procesy z nimi związane (np. serwis).",
        "podstawa": "N",
        "auto": "zlecone"
      },
      {
        "tekst": "Kryteria wyprowadzono z potrzeb procesu i pomiarów.",
        "podstawa": "M",
        "auto": "zPotrzeb"
      },
      {
        "tekst": "Odchylenie widać w ciągu dni; wiadomo, kto reaguje i w jakiej kolejności sprawdza.",
        "podstawa": "M",
        "auto": "reakcja"
      }
    ]
  },
