  "METODY": [
    {
      "kod": "MET-ZR",
      "podstawa": "N",
      "nazwa": "Źródła danych",
      "pomoc": "Faktury, liczniki, system produkcyjny, dane pogodowe, pomiary. Z jakiego okresu.",
      "przyklad": "np. Faktury (en. el., gaz, LPG) 2024–2025; dwa liczniki główne; ERP (masa stali); IMGW (stopniodni, baza 18 °C); pomiary analizatorem"
    },
    {
      "kod": "MET-POD",
      "podstawa": "N",
      "nazwa": "Metody podziału zużycia na obszary",
      "pomoc": "Dla każdego obszaru: pomiar, obliczenie czy oszacowanie — i na jakiej podstawie.",
      "przyklad": "np. Prasy i sprężarkownia — pomiary analizatorem przez 2–4 tygodnie i ekstrapolacja; oświetlenie — inwentaryzacja opraw × czas pracy; kotłownia — różnica licznika gazu i lakierni; reszta — oszacowanie"
    },
    {
      "kod": "MET-PRZ",
      "podstawa": "N",
      "nazwa": "Przeliczniki na wspólną jednostkę i ich źródło",
      "pomoc": "Jedna podstawa dla całego bilansu: ciepło spalania albo wartość opałowa. Zapiszcie, którą wybraliście i skąd pochodzą liczby.",
      "przyklad": "np. Wszystkie paliwa według wartości opałowej (dane dostawców): gaz 10 kWh/m³, LPG 6,67 kWh/l; 1 MWh = 3,6 GJ"
    },
    {
      "kod": "MET-SEU",
      "podstawa": "N",
      "nazwa": "Kryteria wyboru znaczących użyć energii",
      "pomoc": "Z podstawą procentów: od czego liczycie udział. ★ Progi możecie przyjąć własne — ważne, żeby stosować jedne kryteria i uzasadnić każdy wybór.",
      "przyklad": "np. A — udział ≥ 10% całkowitego zużycia energii organizacji (wszystkie rodzaje, MWh); B — udział < 10%, ale potencjał poprawy ≥ 100 MWh rocznie albo wymaganie strony zainteresowanej"
    },
    {
      "kod": "MET-SZE",
      "podstawa": "N",
      "nazwa": "Kryteria szeregowania możliwości poprawy",
      "pomoc": "Na przykład oszczędność i prosty okres zwrotu nakładów.",
      "przyklad": "np. Najpierw działania bez- i niskokosztowe (CAPEX poniżej 100 tys. zł) według SPBT, potem inwestycyjne według SPBT; działania zmniejszające zakup energii osobno"
    },
    {
      "kod": "MET-PRO",
      "podstawa": "N",
      "nazwa": "Metoda prognozy",
      "pomoc": "Jak oszacujecie przyszłe zużycie: model, ekstrapolacja, plan produkcji.",
      "przyklad": "np. Model organizacji z karty EnPI, z prognozą produkcji na kolejny rok i średnimi stopniodniami"
    }
