  "definitions": {
    "ZRODLA_DEF": [
      {
        "kod": "przeglad",
        "punkt": "6.3",
        "nazwa": "Przegląd energetyczny — lista możliwości poprawy",
        "ph": "np. Siedem możliwości, razem około 1 375 MWh rocznie. Zrealizowane: usunięcie nieszczelności i obniżenie ciśnienia. Pozostałe: sterownik i napęd sprężarkowni, LED w halach, odzysk ciepła ze sprężarek."
      },
      {
        "kod": "monitorowanie",
        "punkt": "9.1.1",
        "nazwa": "Dane z monitorowania",
        "ph": "np. K-1 o 1% powyżej linii bazowej w I półroczu — stąd pozycja 5 planu. S-1 pokazuje, że samo ciśnienie nie dowiezie celu Z1.1."
      },
      {
        "kod": "audyty",
        "punkt": "9.2",
        "nazwa": "Ustalenia z audytów wewnętrznych",
        "ph": "np. Audyt A-01/2026: jedna niezgodność i dwie możliwości doskonalenia — wzór protokołu dla wykonawców i luka kompetencyjna w zakupach. Obie w planie (pozycje 1 i 4)."
      },
      {
        "kod": "przeglad_zarz",
        "punkt": "9.3",
        "nazwa": "Decyzje z przeglądu zarządzania",
        "ph": "np. Przegląd 29.09.2026: pytania o energię w procedurze inwestycyjnej, warsztat dla zakupów, analiza K-1 przed sezonem. Cały plan zatwierdzono na tym przeglądzie."
      },
      {
        "kod": "zgloszenia",
        "punkt": "7.4",
        "nazwa": "Zgłoszenia pracowników",
        "ph": "np. Zgłoszenie 2026/08: jeden wyłącznik na całą halę B — weszło do zakresu projektu LED jako podział na trzy strefy."
      },
      {
        "kod": "niezgodnosci",
        "punkt": "10.1",
        "nazwa": "Analiza niezgodności",
        "ph": "np. NK-2026-01 — brak zasad odbioru usług przy SEU (pozycja 1 planu). NK-2026-02 — terminy obowiązków poza kalendarzem (pozycja 3)."
      }
    ],
    "LISTA_102": [
      {
        "tekst": "Doskonali się przydatność, adekwatność i skuteczność systemu.",
        "podstawa": "N",
        "auto": "doskonalenieSystemu"
      },
      {
        "tekst": "Wykazano ciągłą poprawę wyniku energetycznego — EnPI wobec EnB, w porównywalnych warunkach.",
        "podstawa": "N",
        "auto": "poprawaWyniku"
      },
      {
        "tekst": "Możliwości poprawy mają stałe źródła i są oceniane (potencjał, koszt, prosty okres zwrotu, ryzyko).",
        "podstawa": "M",
        "auto": "zrodlaIOcena"
      },
      {
        "tekst": "Prowadzony jest plan doskonalenia z oczekiwanym i osiągniętym efektem (F-EnMS-23).",
        "podstawa": "M",
        "auto": "plan"
      }
    ]
  },
