  "definitions": {
    "PYT_ZA": [
      {
        "kod": "seu",
        "podstawa": "M",
        "tekst": "Dotyczy znaczącego użycia energii albo urządzenia w jego obrębie",
        "ph": "np. Sprężarkownia — SEU, 2 125 MWh, 17,5% zużycia zakładu"
      },
      {
        "kod": "nastawy",
        "podstawa": "M",
        "tekst": "Zmienia nastawy, sterowanie albo sposób regulacji",
        "ph": "np. Sterownik nadrzędny przejmuje kolejność pracy sprężarek i utrzymanie ciśnienia"
      },
      {
        "kod": "godziny",
        "podstawa": "M",
        "tekst": "Dotyczy urządzenia, które będzie pracowało wiele godzin rocznie przez lata",
        "ph": "np. Sprężarkownia pracuje w trybie trzyzmianowym; sterownik i napęd przez kilkanaście lat"
      },
      {
        "kod": "usluga",
        "podstawa": "M",
        "tekst": "To usługa wpływająca na pracę urządzeń — serwis, projekt, wykonawstwo",
        "ph": "np. Serwis sprężarek ustawia ciśnienia i wymienia filtry — to on decyduje o części wyniku",
        "pomoc": "To nie tylko urządzenia. Serwis, który zmienia nastawy, bywa dla energii istotniejszy od urządzenia kupionego raz na dziesięć lat."
      },
      {
        "kod": "energia",
        "podstawa": "M",
        "tekst": "To zakup energii — prądu, gazu, paliwa, ciepła",
        "ph": "np. Umowa na energię elektryczną na 2027 r., ok. 12 000 MWh",
        "pomoc": "Norma wymaga specyfikacji także przy zakupie energii — tam, gdzie to właściwe: struktura cen, profil poboru, ciągłość dostaw, pochodzenie."
      },
      {
        "kod": "prog",
        "podstawa": "M",
        "tekst": "Przekracza próg wartości ustalony w firmie — sygnał pomocniczy",
        "ph": "np. 380 tys. zł, próg w firmie 100 tys. zł",
        "pomoc": "★ Próg kwotowy nie może być jedynym kryterium. Tania usługa serwisowa, która zmienia nastawy kotłowni, może znaczyć dla energii więcej niż drogie wyposażenie biura."
      }
    ],
    "PYT_ZC": [
      {
        "kod": "informacja",
        "podstawa": "N",
        "tekst": "Dostawcy zostali poinformowani, że wynik energetyczny jest jednym z kryteriów oceny",
        "ph": "np. Zdanie w punkcie 4 zapytania ofertowego z 12.10.2026, powtórzone w specyfikacji",
        "pomoc": "Wymaganie normy przy zakupach wpływających na znaczące użycia energii. W praktyce jedno zdanie — ale musi być w zapytaniu, nie w notatce wewnętrznej."
      },
      {
        "kod": "specyfikacja",
        "podstawa": "N",
        "tekst": "Określono specyfikację dotyczącą wyniku energetycznego — tam, gdzie to właściwe",
        "ph": "np. Wymagania minimalne: dwie nastawy ciśnienia, zapis danych pracy, dwa przetworniki u odbiorców, przyłącza pod odzysk ciepła",
        "pomoc": "Dotyczy zakupu energii, produktów i usług mających wpływ na znaczące użycia energii."
      },
      {
        "kod": "dane",
        "podstawa": "M",
        "tekst": "Wskazano, jakich danych o zużyciu oczekujecie — i w jakich warunkach",
        "ph": "np. Zużycie [MWh/rok] i kWh/Nm³ przy profilu pracy z załącznika i ciśnieniu 6,3 bar, z metodą obliczeń"
      },
      {
        "kod": "kryterium",
        "podstawa": "M",
        "tekst": "Podano, jak oferty będą porównywane",
        "ph": "np. Spośród ofert spełniających wymagania minimalne — najniższy koszt zakupu i energii w 15 lat przy 890 zł/MWh"
      }
    ],
    "LISTA_83": [
      {
        "tekst": "Dla zakupów o znaczącym wpływie ustalono kryteria oceny wyniku energetycznego w okresie użytkowania.",
        "podstawa": "N",
        "auto": "kryteria"
      },
      {
        "tekst": "Dostawcy są informowani, że wynik energetyczny jest jednym z kryteriów oceny.",
        "podstawa": "N",
        "auto": "informuje"
      },
      {
        "tekst": "Przy zakupie energii, produktów i usług mających wpływ na znaczące użycia energii określono specyfikacje.",
        "podstawa": "N",
        "auto": "specyfikacje"
      },
      {
        "tekst": "Ocena wpływu obejmuje także usługi i zakup energii, a próg kwotowy jest tylko sygnałem pomocniczym.",
        "podstawa": "M",
        "auto": "wplyw"
      },
      {
        "tekst": "Oferty porównuje się na danych dla profilu pracy zakładu, nie na mocy znamionowej.",
        "podstawa": "M",
        "auto": "profil"
      },
      {
        "tekst": "Założenia porównania — okres, cena energii, profil — są zapisane.",
        "podstawa": "M",
        "auto": "zalozenia"
      },
      {
        "tekst": "Deklaracje dostawcy są sprawdzane przy odbiorze, a kryteria obsługi przekazywane do nadzoru operacyjnego.",
        "podstawa": "M",
        "auto": "odbior"
      }
    ]
  },
