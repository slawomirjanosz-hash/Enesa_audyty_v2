  "definitions": {
    "LISTA_912": [
      {
        "tekst": "W zaplanowanych odstępach oceniana jest zgodność z wymaganiami prawnymi i innymi dotyczącymi energii i systemu.",
        "podstawa": "N",
        "auto": "oceniana"
      },
      {
        "tekst": "Zachowano wyniki oceny i zapis podjętych działań.",
        "podstawa": "N",
        "auto": "zapisy"
      },
      {
        "tekst": "Przy ocenie zapisano datę stanu prawnego; przy braku zgodności przeanalizowano przyczynę.",
        "podstawa": "M",
        "auto": "stanIPrzyczyna"
      }
    ]
  },
