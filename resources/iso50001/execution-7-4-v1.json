  "definitions": {
    "LISTA_74": [
      {
        "tekst": "Ustalono komunikację wewnętrzną i zewnętrzną: o czym, kiedy, z kim, w jaki sposób i kto przekazuje.",
        "podstawa": "N",
        "auto": "ustalono"
      },
      {
        "tekst": "Przekazywane informacje są wiarygodne i zgodne z informacjami wytworzonymi w systemie.",
        "podstawa": "N",
        "auto": "wiarygodne"
      },
      {
        "tekst": "Działa proces, w którym każda osoba pracująca pod nadzorem organizacji może zgłaszać uwagi i propozycje doskonalenia.",
        "podstawa": "N",
        "auto": "proces"
      },
      {
        "tekst": "Rozważono zachowanie zapisów zgłoszonych propozycji (rejestr zgłoszeń).",
        "podstawa": "N",
        "auto": "zapisy"
      },
      {
        "tekst": "Każde zgłoszenie dostaje odpowiedź — także wtedy, gdy jest nią uzasadniona odmowa.",
        "podstawa": "M",
        "auto": "odpowiedzi"
      }
    ]
  },
