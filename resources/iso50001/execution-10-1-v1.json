  "definitions": {
    "LISTA_101": [
      {
        "tekst": "Na niezgodności reaguje się: opanowanie, korekcja, zajęcie się konsekwencjami.",
        "podstawa": "N",
        "auto": "reakcja"
      },
      {
        "tekst": "Ocenia się potrzebę działania korygującego: przegląd niezgodności, przyczyny, podobne przypadki gdzie indziej.",
        "podstawa": "N",
        "auto": "ocenaPotrzeby"
      },
      {
        "tekst": "Potrzebne działania są wdrażane i adekwatne do skutków niezgodności.",
        "podstawa": "N",
        "auto": "wdrozenie"
      },
      {
        "tekst": "Przegląda się skuteczność działań korygujących.",
        "podstawa": "N",
        "auto": "przegladSkutecznosci"
      },
      {
        "tekst": "W razie potrzeby wprowadza się zmiany w systemie.",
        "podstawa": "N",
        "auto": "zmianySystemu"
      },
      {
        "tekst": "Zachowano zapisy o charakterze niezgodności, działaniach i wynikach działań korygujących.",
        "podstawa": "N",
        "auto": "zapisy"
      },
      {
        "tekst": "Przy podjętym działaniu korygującym niezgodność zamyka się na dowodzie skuteczności, nie na wykonaniu działania.",
        "podstawa": "M",
        "auto": "zamkniecie"
      },
      {
        "tekst": "Prowadzony jest rejestr (F-EnMS-22) i karty (F-EnMS-21); stosowana jest metoda analizy przyczyn.",
        "podstawa": "M",
        "auto": "narzedzia"
      }
    ]
  },
