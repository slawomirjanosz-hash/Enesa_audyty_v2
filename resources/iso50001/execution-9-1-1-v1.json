  "definitions": {
    "CHARAKTERYSTYKI": [
      {
        "kod": "plany",
        "nazwa": "Skuteczność planów działań w osiąganiu celów i zadań",
        "pomoc": "Nie „czy działanie wykonano”, ale czy przynosi zakładany efekt.",
        "ph": "np. Czy działania z planu C1 (III-24) są wykonane i czy przynoszą zakładany efekt — przepływ w postoju 9 → 6 Nm³/min",
        "phZ": "np. Plan działań III-24; protokoły testów weekendowych",
        "phM": "np. Test weekendowy przepływomierzem przy wszystkich maszynach wyłączonych i zaworach jak w teście bazowym; porównanie z wartością bazową 9 Nm³/min",
        "phCz": "np. co kwartał",
        "phP": "np. brak postępu między dwoma kolejnymi testami"
      },
      {
        "kod": "enpi",
        "nazwa": "Wskaźniki wyniku energetycznego (EnPI)",
        "ph": "np. O-1 zakład, P-1 prasy, L-1 lakiernia, S-1 sprężarkownia, K-1 kotłownia, OŚ-1 oświetlenie",
        "phZ": "np. Podliczniki obszarowe, przepływomierz sprężarkowni, faktury, raporty produkcyjne",
        "phM": "np. Karty wskaźników z punktu 6.4; każdy EnPI liczony metodą z karty i porównywany z odpowiadającą mu EnB w porównywalnych warunkach",
        "phCz": "np. co miesiąc; S-1 co tydzień",
        "phP": "np. 3% wobec średniej z ostatnich okresów; S-1 — 3% tygodniowo"
      },
      {
        "kod": "seu",
        "nazwa": "Działanie znaczących użyć energii",
        "pomoc": "Czy SEU pracują według kryteriów ustalonych w punkcie 8.1.",
        "ph": "np. Czy sprężarkownia utrzymuje ciśnienie ≤ 6,3 bar i czy tryby postoju są stosowane",
        "phZ": "np. Trend ciśnienia ze sterownika; zapisy obchodów; protokoły serwisu",
        "phM": "np. Odczyt trendu ciśnienia z rejestratora sterownika i przegląd zapisów obchodów; przy każdej usłudze serwisowej — protokół z nastawami przed i po",
        "phCz": "np. na bieżąco (sterownik, obchody)",
        "phP": "np. każde przekroczenie 6,3 bar dłuższe niż 4 h"
      },
      {
        "kod": "rzeczOcz",
        "nazwa": "Zużycie rzeczywiste w porównaniu z oczekiwanym",
        "ph": "np. Model zakładu: 0,23 MWh na tonę stali, 0,48 MWh na stopniodzień, 406 MWh zużycia stałego w miesiącu",
        "phZ": "np. Liczniki główne energii elektrycznej, gazu i LPG; raport produkcyjny; stopniodni z danych meteorologicznych",
        "phM": "np. Zużycie oczekiwane z modelu regresji (III-22) przy rzeczywistej produkcji i stopniodniach; iloraz rzeczywistego i oczekiwanego jako wskaźnik O-1",
        "phCz": "np. co miesiąc",
        "phP": "np. iloraz powyżej 1,03 albo wzrost o 3 punkty procentowe wobec poprzedniego miesiąca"
      }
    ],
    "LISTA_911": [
      {
        "tekst": "Ustalono, co monitorować i mierzyć — co najmniej: skuteczność planów działań, EnPI, działanie SEU, zużycie rzeczywiste wobec oczekiwanego.",
        "podstawa": "N",
        "auto": "co"
      },
      {
        "tekst": "Ustalono metody monitorowania, pomiaru, analizy i oceny zapewniające wiarygodne wyniki.",
        "podstawa": "N",
        "auto": "metody"
      },
      {
        "tekst": "Ustalono, kiedy prowadzi się pomiary i kiedy analizuje i ocenia wyniki.",
        "podstawa": "N",
        "auto": "kiedy"
      },
      {
        "tekst": "Oceniany jest wynik energetyczny — EnPI wobec odpowiadających im EnB.",
        "podstawa": "N",
        "auto": "enpiEnb"
      },
      {
        "tekst": "Oceniana jest skuteczność systemu.",
        "podstawa": "N",
        "auto": "skutecznosc"
      },
      {
        "tekst": "Znaczące odchylenia są badane, a reakcje — zapisane.",
        "podstawa": "N",
        "auto": "odchylenia"
      },
      {
        "tekst": "Zachowano zapisy wyników monitorowania i pomiarów.",
        "podstawa": "N",
        "auto": "zapisy"
      },
      {
        "tekst": "Ustalono i stosuje się kryteria identyfikowania znaczących odchyleń.",
        "podstawa": "N",
        "auto": "progi"
      },
      {
        "tekst": "Raport z monitorowania zawiera wnioski i rekomendacje (III-41).",
        "podstawa": "M",
        "auto": "wnioski"
      }
    ]
  },
