  "definitions": {
    "PYT_A": [
      {
        "kod": "seu",
        "podstawa": "M",
        "tekst": "Dotyczy znaczącego użycia energii albo tworzy nowe",
        "ph": "np. Dotyczy SEU sprężarkownia — 17,5% zużycia zakładu"
      },
      {
        "kod": "sterowanie",
        "podstawa": "M",
        "tekst": "Zmienia sposób sterowania lub nastawy",
        "ph": "np. Sterownik nadrzędny przejmuje kolejność pracy sprężarek i utrzymanie ciśnienia"
      },
      {
        "kod": "godziny",
        "podstawa": "M",
        "tekst": "Dotyczy urządzenia, które będzie pracowało wiele godzin rocznie przez lata",
        "ph": "np. Sprężarkownia pracuje w trybie trzyzmianowym; sterownik i napęd przez kilkanaście lat"
      },
      {
        "kod": "prog",
        "podstawa": "M",
        "tekst": "Przekracza próg wartości ustalony w firmie — sygnał pomocniczy",
        "ph": "np. 380 tys. zł, próg w firmie 100 tys. zł",
        "pomoc": "Próg kwotowy może być sygnałem dodatkowym — nigdy jedynym. Przebudowa sterowania za kilkanaście tysięcy może zmienić zużycie bardziej niż remont biurowca za kilka milionów."
      }
    ],
    "PYT_B": [
      {
        "kod": "mozliwosci",
        "podstawa": "N",
        "tekst": "Rozważono możliwości poprawy wyniku energetycznego w okresie eksploatacji",
        "ph": "np. Rozważono: obniżanie ciśnienia poza produkcją, napęd falownikowy, odzysk ciepła ze sprężarek, wymianę wszystkich czterech sprężarek"
      },
      {
        "kod": "oszacowano",
        "podstawa": "M",
        "tekst": "Oszacowano przewidywane zużycie energii w okresie eksploatacji",
        "ph": "np. Po modernizacji ok. 1 600 MWh/rok wobec 1 830 MWh po obniżeniu ciśnienia i usunięciu wycieków"
      },
      {
        "kod": "potrzeby",
        "podstawa": "M",
        "tekst": "Rozwiązanie dobrano do rzeczywistych potrzeb — bez nadmiernego zapasu",
        "ph": "np. Napęd falownikowy dla jednej sprężarki, nie dla wszystkich czterech — profil obciążenia wymaga regulacji tylko jednej jednostki"
      },
      {
        "kod": "warianty",
        "podstawa": "M",
        "tekst": "Rozważono warianty o niższym zużyciu",
        "ph": "np. Porównano: sam sterownik, sterownik z jednym napędem, wymiana wszystkich sprężarek"
      },
      {
        "kod": "cieplo",
        "podstawa": "M",
        "tekst": "Sprawdzono możliwość wykorzystania ciepła odpadowego lub innej odzyskiwalnej energii",
        "ph": "np. Odzysk ciepła ze sprężarek rozważony — przesunięty poza tę inwestycję, ale projekt zostawia miejsce i przyłącza"
      },
      {
        "kod": "tco",
        "podstawa": "M",
        "tekst": "Porównano koszt zakupu i energii wariantów — uproszczone TCO",
        "ph": "np. Porównanie w 15 lat przy cenie 890 zł/MWh — część D formularza zakupowego F-EnMS-16"
      }
    ],
    "PYT_C": [
      {
        "kod": "nadzor",
        "podstawa": "N",
        "tekst": "Rozważono nadzór operacyjny w okresie eksploatacji",
        "ph": "np. Sprawdzono, czy kryteria z karty sprężarkowni (8.1) da się stosować po modernizacji"
      },
      {
        "kod": "wylaczanie",
        "podstawa": "M",
        "tekst": "Można wyłączyć to, co w danej chwili niepotrzebne",
        "ph": "np. Sterownik wyłącza sprężarki poza produkcją; tryb postoju z jedną jednostką tylko przy odbiorze"
      },
      {
        "kod": "regulacja",
        "podstawa": "M",
        "tekst": "Układ ma regulację do rzeczywistego zapotrzebowania, także poza produkcją",
        "ph": "np. Dwie nastawy ciśnienia: produkcja i postój — wymaganie minimalne w specyfikacji"
      },
      {
        "kod": "pomiar",
        "podstawa": "M",
        "tekst": "Przewidziano pomiar, z którego da się policzyć wskaźnik",
        "ph": "np. Zapis danych pracy (obciążenie, ciśnienie, godziny) z eksportem do monitoringu; dwa przetworniki ciśnienia u odbiorców"
      },
      {
        "kod": "ktoObsluga",
        "podstawa": "M",
        "tekst": "Wiadomo, kto będzie obsługiwał instalację i według jakich kryteriów (8.1)",
        "ph": "np. Technicy UR według karty kryteriów F-EnMS-14 zaktualizowanej przed uruchomieniem; serwis według zlecenia"
      }
    ],
    "PYT_D": [
      {
        "kod": "wprowadzono",
        "podstawa": "N",
        "tekst": "Wyniki rozważań wprowadzono do specyfikacji, projektu i zakupów",
        "ph": "np. Cztery wnioski weszły do wymagań minimalnych specyfikacji zakupowej (III-38, część A) i do zapytania ofertowego z 10.2026"
      },
      {
        "kod": "zachowano",
        "podstawa": "N",
        "tekst": "Zachowano informacje o działaniach projektowych — ta lista albo notatka",
        "ph": "np. Wypełniona lista F-EnMS-15 oraz notatka z przeglądu koncepcji z 09.2026 w teczce projektu"
      }
    ],
    "LISTA_82": [
      {
        "tekst": "Rozpoznawane są projekty mogące znacząco wpłynąć na wynik energetyczny.",
        "podstawa": "N",
        "auto": "rozpoznanie"
      },
      {
        "tekst": "W tych projektach rozważa się możliwości poprawy i nadzór operacyjny w okresie eksploatacji.",
        "podstawa": "N",
        "auto": "rozwaza"
      },
      {
        "tekst": "Wyniki rozważań są w specyfikacjach, projekcie i zakupach (w stosownych przypadkach).",
        "podstawa": "N",
        "auto": "wyniki"
      },
      {
        "tekst": "Zachowano udokumentowane informacje o działaniach projektowych związanych z wynikiem energetycznym.",
        "podstawa": "N",
        "auto": "zapisy"
      },
      {
        "tekst": "Pytania o energię padają na etapie założeń; stosowana jest lista kontrolna projektu.",
        "podstawa": "M",
        "auto": "zalozenia"
      },
      {
        "tekst": "Po uruchomieniu wynik porównuje się w porównywalnych warunkach.",
        "podstawa": "M",
        "auto": "poUruchomieniu"
      }
    ]
  },
