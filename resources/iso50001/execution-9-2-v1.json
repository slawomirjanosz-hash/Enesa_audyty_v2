  "source_sha256": "bb84af3cb08cd9eaa0fbaf06a0b30452d2607c9b43ee1255655969f2fc0c82e8",
  "definitions": {
    "PYT_B9": [
      {
        "kod": "poprawa",
        "tekst": "Czy system poprawia wynik energetyczny?",
        "ph": "np. Tak. O-1 0,965 wobec EnB 1,000 (VIII 2026); S-1 0,118 wobec 0,125; P-1 121,5 wobec 124,0. Poprawa wykazana pomiarem i modelem, nie samym spadkiem zużycia. K-1 wymaga analizy przed sezonem grzewczym.",
        "pomoc": "Pytanie a) z punktu 9.2. Odpowiedź opiera się na wynikach monitorowania (9.1.1), nie na przekonaniu."
      },
      {
        "kod": "zgodnosc",
        "tekst": "Czy system jest zgodny z wymaganiami organizacji, polityką, celami i zadaniami oraz z wymaganiami normy?",
        "ph": "np. W większości tak. Jedna niezgodność z wymaganiem ustalonym przez samą organizację (8.1, nadzór nad procesem zleconym): protokół serwisu bez nastaw, protokołu nie sprawdzano przy odbiorze. Polityka, cele i zadania spójne z planami działań; wymagania normy dla punktów 4–8 spełnione.",
        "pomoc": "Pytanie b). Dotyczy zgodności z tym, co organizacja sama ustaliła — <b>i</b> z normą."
      },
      {
        "kod": "wdrozenie",
        "tekst": "Czy system jest skutecznie wdrożony i utrzymywany?",
        "ph": "np. Tak, z zastrzeżeniem. Kryteria sprężarkowni są stosowane — potwierdzone trendem ciśnienia i rozmową z technikami. Słabe miejsce: nadzór nad wykonawcami — wymaganie ustalone po czerwcowym zdarzeniu działa tylko w połowie (zlecenie jest, kontroli odbioru nie ma).",
        "pomoc": "Pytanie c) — czyli czy ustalenia żyją na hali, a nie tylko w dokumentach."
      }
    ],
    "LISTA_92": [
      {
        "tekst": "Audyty w zaplanowanych odstępach odpowiadają na pytania: poprawa wyniku, zgodność, skuteczne wdrożenie.",
        "podstawa": "N",
        "auto": "trzyPytania"
      },
      {
        "tekst": "Program uwzględnia znaczenie procesów i wyniki wcześniejszych audytów.",
        "podstawa": "N",
        "auto": "program"
      },
      {
        "tekst": "Dla każdego audytu określono zakres i kryteria.",
        "podstawa": "N",
        "auto": "zakresKryteria"
      },
      {
        "tekst": "Audytorzy zapewniają obiektywność i bezstronność.",
        "podstawa": "N",
        "auto": "bezstronnosc"
      },
      {
        "tekst": "Wyniki przekazano odpowiedniemu kierownictwu; podjęto odpowiednie działania.",
        "podstawa": "N",
        "auto": "przekazanie"
      },
      {
        "tekst": "Zachowano dowody realizacji programu i wyniki audytów.",
        "podstawa": "N",
        "auto": "zapisy"
      },
      {
        "tekst": "Ustalenia opierają się na dowodach z praktyki; audytu nie ocenia się liczbą niezgodności.",
        "podstawa": "M",
        "auto": "dowody"
      }
    ]
  },
